# ── AI API (둘 중 하나 필수, Groq 우선) ─────────────────────────
# Groq API — 무료 (기본)
GROQ_API_KEY=

# Claude API — fallback (Groq 없을 때 사용)
ANTHROPIC_API_KEY=

# ── 네이버 API (SEO 벤치마크용, 선택) ──────────────────────────────
# 없으면 벤치마크 기본값(2000자 목표 등)으로 동작
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 쿠팡 파트너스 ───────────────────────────────────────────────────
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_AFFILIATE_ID=

# ── Google Blogger (GitHub Secrets에 등록) ────────────────────────
BLOGGER_TOKEN=
BLOGGER_BLOG_ID=
GOOGLE_INDEXING_SA=
